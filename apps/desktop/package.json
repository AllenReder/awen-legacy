{
  "name": "@awen/desktop",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "main": "dist-electron/boot.cjs",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron-runtime.mjs",
    "start": "node scripts/start-electron.mjs",
    "build:bundle": "vp pack",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@awen/client-runtime": "workspace:*",
    "@awen/contracts": "workspace:*",
    "@awen/shared": "workspace:*",
    "@awen/ssh": "workspace:*",
    "@awen/tailscale": "workspace:*",
    "@crowecawcaw/xa11y": "0.13.0",
    "@effect/platform-node": "catalog:",
    "@napi-rs/keyring": "^1.3.0",
    "dbus-next": "0.10.2",
    "effect": "catalog:",
    "electron": "44.1.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "ffi-rs": "1.3.2",
    "playwright-core": "1.60.0",
    "react-grab": "^0.1.32"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "acorn": "8.16.0",
    "cross-env": "^10.1.0",
    "electron-builder": "26.15.6",
    "tailwindcss": "catalog:",
    "vite-plus": "catalog:"
  },
  "productName": "Awen",
  "build": {
    "appId": "com.allenreder.awen",
    "productName": "Awen",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
